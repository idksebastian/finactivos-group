# Copy this file to .env and fill in real values. Never commit .env.

# Public site URL — used to build canonical links and Open Graph URLs.
# Set to the real production domain once it's connected (e.g. in Vercel).
VITE_SITE_URL=https://finactivos.com

# Supabase project connection.
# Client-side (exposed to the browser via Vite's VITE_ prefix — safe to expose,
# these are the public URL and the publishable/anon key, not secrets).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side (read via process.env in server functions/middleware — same
# values as above, without the VITE_ prefix, since Vite only injects VITE_*
# into the client bundle).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Server-side only — service role key, bypasses Row Level Security.
# NEVER expose this to the client or prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
